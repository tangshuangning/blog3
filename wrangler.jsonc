{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "POSTS",
      "id": "fd0958d014da4d7ea7ad7e7d2d0fdc79"
    }
  ]
}
