{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "COMMENT_STORE",
        "class_name": "CommentStore"
      },
      {
        "name": "COMMUNITY_STORE",
        "class_name": "CommunityStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "comment-store-v1",
      "new_sqlite_classes": ["CommentStore"]
    },
    {
      "tag": "community-store-v1",
      "new_sqlite_classes": ["CommunityStore"]
    }
  ],

  "kv_namespaces": [
    {
      "binding": "POSTS",
      "id": "fd0958d014da4d7ea7ad7e7d2d0fdc79"
    }
  ]
}
